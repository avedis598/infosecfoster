{
  "title": "IT Admin Console",
  "uid": "admin-console",
  "schemaVersion": 38,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "agent",
        "type": "query",
        "datasource": {
          "uid": "OpenSearch"
        },
        "query": "{\"find\": \"terms\", \"field\": \"agent.name\"}",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "refresh": 2
      },
      {
        "name": "severity",
        "type": "custom",
        "options": [
          {
            "text": "Critical",
            "value": "Critical"
          },
          {
            "text": "High",
            "value": "High"
          },
          {
            "text": "Medium",
            "value": "Medium"
          },
          {
            "text": "Low",
            "value": "Low"
          }
        ],
        "query": "Critical,High,Medium,Low",
        "multi": true,
        "includeAll": true
      },
      {
        "name": "os",
        "type": "query",
        "datasource": {
          "uid": "OpenSearch"
        },
        "query": "{\"find\": \"terms\", \"field\": \"agent.os.name\"}",
        "multi": true,
        "includeAll": true,
        "refresh": 2
      },
      {
        "name": "site",
        "type": "custom",
        "options": [
          {
            "text": "Head Office",
            "value": "Head Office"
          },
          {
            "text": "Branch",
            "value": "Branch"
          },
          {
            "text": "Remote",
            "value": "Remote"
          }
        ],
        "query": "Head Office,Branch,Remote",
        "multi": true,
        "includeAll": true
      }
    ]
  },
