{
  "name": "PB12 - Container Security & Kubernetes Defense",
  "description": "Monitors Docker/Kubernetes for rogue containers or unauthorized root shell access, automatically killing compromised containers.",
  "actions": [
    {
      "id": "slack-devsecops",
      "name": "Alert DevSecOps",
      "app_name": "Slack",
      "app_version": "1.0.0",
      "position": { "x": 300, "y": 150 },
      "parameters": [
        { "name": "channel", "value": "#container-security" },
        { "name": "text", "value": "🚨 **Container Security Violation** 🚨\n\n- **Host**: $exec.text.agent.name\n- **Container ID**: $exec.text.data.docker.container.id\n- **Event**: $exec.text.rule.description\n\nAn unauthorized shell was spawned, or a privileged container was launched. Initiating automated container suspension." }
      ],
      "priority": 0
    },
    {
      "id": "docker-kill",
      "name": "Kill Compromised Container",
      "app_name": "Wazuh",
      "app_version": "1.0.0",
      "position": { "x": 300, "y": 300 },
      "parameters": [
        { "name": "command", "value": "docker-pause" },
        { "name": "arguments", "value": "[\"$exec.text.data.docker.container.id\"]" },
        { "name": "agent_id", "value": "$exec.text.agent.id" }
      ],
      "priority": 0
    }
  ],
  "triggers": [
    { "id": "webhook-trigger", "name": "Wazuh Webhook", "app_name": "Webhook", "type": "webhook", "position": { "x": 50, "y": 150 }, "parameters": [] }
  ],
  "branches": [
    { "id": "branch-1", "source_id": "webhook-trigger", "destination_id": "slack-devsecops", "conditions": [
        { "condition": { "name": "", "value": "Contains" }, "source": { "name": "", "value": "$exec.text.rule.groups" }, "destination": { "name": "", "value": "docker" } }
    ] },
    { "id": "branch-2", "source_id": "slack-devsecops", "destination_id": "docker-kill", "conditions": [] }
  ],
  "object_type": "workflow", "id": "pb12-container-sec", "is_valid": true
}
