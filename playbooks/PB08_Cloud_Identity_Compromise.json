{
  "name": "PB08 - Cloud Identity Compromise (IAM)",
  "description": "Detects anomalous AWS/Azure logins, sends a Slack approval request to the SOC, and disables the cloud user if approved.",
  "actions": [
    {
      "id": "slack-approval",
      "name": "Ask SOC to Suspend User",
      "app_name": "Slack",
      "app_version": "1.0.0",
      "position": { "x": 300, "y": 150 },
      "parameters": [
        { "name": "channel", "value": "#soc-alerts" },
        { "name": "text", "value": "🚨 Cloud Identity Compromise Detected!\nUser `$exec.text.data.aws.userIdentity.userName` logged in from an anomalous location.\n\nDo you want to instantly revoke their AWS session and disable the account?" }
      ],
      "priority": 0
    },
    {
      "id": "aws-iam-disable",
      "name": "Disable AWS IAM User",
      "app_name": "AWS IAM",
      "app_version": "1.0.0",
      "position": { "x": 300, "y": 300 },
      "parameters": [
        { "name": "UserName", "value": "$exec.text.data.aws.userIdentity.userName" }
      ],
      "priority": 0
    }
  ],
  "triggers": [
    { "id": "webhook-trigger", "name": "Wazuh Webhook", "app_name": "Webhook", "type": "webhook", "position": { "x": 50, "y": 150 }, "parameters": [] }
  ],
  "branches": [
    { "id": "branch-1", "source_id": "webhook-trigger", "destination_id": "slack-approval", "conditions": [] },
    { "id": "branch-2", "source_id": "slack-approval", "destination_id": "aws-iam-disable", "conditions": [
        { "condition": { "name": "", "value": "Equals" }, "source": { "name": "", "value": "$slack-approval.action" }, "destination": { "name": "", "value": "approve" } }
    ] }
  ],
  "object_type": "workflow", "id": "pb08-cloud-iam", "is_valid": true
}
