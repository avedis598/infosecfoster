      "name": "Create TheHive Case",
      "app_name": "TheHive",
      "app_version": "1.0.0",
      "position": {
        "x": 300,
        "y": 300
      },
      "parameters": [
        {
          "name": "title",
          "value": "Brute Force Attack Detected: Blocked Source IP ($exec.text.data.srcip)"
        },
        {
          "name": "description",
          "value": "System telemetry registered SSH brute force. Source IP has been blocked at the agent firewall.\n\n- Attacker IP: $exec.text.data.srcip\n- Agent Host: $exec.text.agent.name\n- Rule ID: $exec.text.rule.id\n- Timestamp: $exec.text.timestamp"
        },
        {
          "name": "severity",
          "value": "3"
        },
        {
          "name": "tags",
          "value": "[\"brute-force\", \"active-response\", \"sshd\"]"
        }
      ],
      "large_image": "",
      "priority": 0
    },
    {
      "id": "1d15c1cc-bc3d-4d68-aff5-ce056847951a",
      "name": "Send Alert Email",
      "app_name": "Email",
      "app_version": "1.0.0",
      "position": {
        "x": 300,
        "y": 450
      },
      "parameters": [
        {
          "name": "recipient",
          "value": "admin@amlsiem.com"
        },
        {
          "name": "subject",
          "value": "CRITICAL: Brute Force Blocked on $exec.text.agent.name"
        },
        {
          "name": "body",
          "value": "A brute force attack was detected and successfully blocked.\n\nAttacker IP: $exec.text.data.srcip\nTarget Agent: $exec.text.agent.name\n\nPlease review TheHive for case details."
        }
      ],
      "large_image": "",
      "priority": 0
    }
  ],
